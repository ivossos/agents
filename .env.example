# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# HOST=0.0.0.0        # Set automatically in Docker; leave unset for localhost-only dev

# ── Authentication ───────────────────────────────────────────────────────────
# Optional bearer token — if set, every /api/* request must include:
#   Authorization: Bearer <token>   OR   ?token=<token>
# CONTROL_TOKEN=change-me-in-production

# ── Claude CLI ───────────────────────────────────────────────────────────────
# Path to the claude binary (defaults to "claude" on $PATH)
# CLAUDE_BIN=claude

# Your Anthropic API key — required for the claude CLI to run agents
ANTHROPIC_API_KEY=sk-ant-...

# ── Paths ────────────────────────────────────────────────────────────────────
# Directory that contains the agent department folders (default: repo root)
# AGENTS_DIR=/app

# Working directory where agents run (default: same as AGENTS_DIR)
# WORKDIR=/app

# ── Concurrency & Limits ─────────────────────────────────────────────────────
# MAX_PARALLEL=4          # Max simultaneous agent runs
# MAX_QUEUE=50            # Max runs waiting for a slot (429 beyond this)
# MAX_ACTIVE_WORKFLOWS=20
# RUN_TIMEOUT_MIN=15      # Kill a run after this many minutes (0 = unlimited)
# MAX_OUTPUT_KB=256       # Cap stored/streamed output per run

# ── Advanced ─────────────────────────────────────────────────────────────────
# ALLOW_ANY_HOST=1        # Disable localhost-only Host header check (set in Docker)
# KILL_GRACE_MS=5000      # ms between SIGTERM and SIGKILL when stopping a run
